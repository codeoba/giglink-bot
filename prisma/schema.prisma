generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id               Int            @id @default(autoincrement())
  telegramId       BigInt         @unique
  firstName        String         @default("")
  username         String         @default("")
  role             Role           @default(FREELANCER)
  adminRole        String?
  trustScore       Float          @default(0)
  balance          Float          @default(0)
  level            String         @default("🥉 Novice")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  referralCode     String?        @unique
  referredById     Int?
  streakDays       Int            @default(0)
  lastActiveAt     DateTime?
  isVacationMode   Boolean        @default(false)
  isVerifiedPro    Boolean        @default(false)

  jobsPosted       Job[]          @relation("ClientJobs")
  gigs             Gig[]
  disputes         Dispute[]
  proposals        Proposal[]     @relation("FreelancerProposals")
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  reviewsGiven     Review[]       @relation("GivenReviews")
  reviewsReceived  Review[]       @relation("ReceivedReviews")
  paymentsMade     Payment[]      @relation("PayerPayments")
  paymentsReceived Payment[]      @relation("PayeePayments")
  notifications    Notification[]
  badges           SkillBadge[]
  wallets          Wallet[]
  retainersClient  RetainerContract[] @relation("ClientRetainers")
  retainersFree    RetainerContract[] @relation("FreelancerRetainers")
  referralRewardsGiven   ReferralReward[] @relation("ReferralRewardGiven")
  referralRewardsReceived ReferralReward[] @relation("ReferralRewardReceived")
  digitalProductsSold    DigitalProduct[] @relation("DigitalProductsSold")
  digitalPurchases       DigitalPurchase[] @relation("DigitalPurchases")
  companyPage            CompanyPage?     @relation("CompanyPageOwner")
  favoriteFreelancers    FavoriteFreelancer[] @relation("ClientFavorites")
  favoritedBy            FavoriteFreelancer[] @relation("FavoritedBy")
  ownedAgency            Agency?          @relation("AgencyOwner")
  agencyMembership       AgencyMember?    @relation("AgencyMemberRel")
  subContracts           SubContract[]    @relation("SubContractorRel")
  bountiesPosted         Bounty[]         @relation("ClientBounties")
  bountySubmissions      BountySubmission[] @relation("FreelancerBountySubmissions")
}

model Job {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  category    String     @default("General")
  skills      String     @default("")
  budget      Float
  deadline    DateTime?
  status      JobStatus  @default(OPEN)
  clientId    Int
  client      User       @relation("ClientJobs", fields: [clientId], references: [id])
  proposals   Proposal[]
  messages    Message[]
  review      Review?
  payment     Payment?
  contract    Contract?
  invoice     Invoice?
  tasks       Task[]
  successScore Float?
  hasInsurance Boolean    @default(false)
  insuranceFee Float      @default(0)
  currency     String     @default("TZS")
  isTrial      Boolean    @default(false)
  isConcierge  Boolean    @default(false)
  subContracts SubContract[] @relation("JobSubContracts")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Gig {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?  @db.Text
  packages     String?  @db.Text
  category     String   @default("General")
  skills       String   @default("")
  price        Float
  deliveryTime String
  avgRating    Float    @default(0)
  freelancerId Int
  freelancer   User     @relation(fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Proposal {
  id               Int            @id @default(autoincrement())
  coverLetter      String         @db.Text
  price            Float
  status           ProposalStatus @default(PENDING)
  aiScore          Float?
  aiRecommendation String?        @db.Text
  freelancerId     Int
  freelancer       User           @relation("FreelancerProposals", fields: [freelancerId], references: [id])
  jobId            Int
  job              Job            @relation(fields: [jobId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  read       Boolean  @default(false)
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  jobId      Int?
  job        Job?     @relation(fields: [jobId], references: [id])
  createdAt  DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?  @db.Text
  reviewerId Int
  reviewer   User     @relation("GivenReviews", fields: [reviewerId], references: [id])
  revieweeId Int
  reviewee   User     @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  jobId      Int      @unique
  job        Job      @relation(fields: [jobId], references: [id])
  createdAt  DateTime @default(now())
}

model Payment {
  id           Int           @id @default(autoincrement())
  amount       Float
  currency     String        @default("TZS")
  commission   Float         @default(0)
  taxAmount    Float         @default(0)
  insuranceFee Float         @default(0)
  status       PaymentStatus @default(PENDING)
  escrowStatus EscrowStatus  @default(HELD)
  mpesaRef     String?
  jobId        Int           @unique
  job          Job           @relation(fields: [jobId], references: [id])
  payerId      Int
  payer        User          @relation("PayerPayments", fields: [payerId], references: [id])
  payeeId      Int
  payee        User          @relation("PayeePayments", fields: [payeeId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Dispute {
  id               Int           @id @default(autoincrement())
  reason           String        @db.Text
  aiRecommendation String?       @db.Text
  status           DisputeStatus @default(PENDING)
  jobId            Int?
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  type      String   @default("INFO")
  read      Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model SkillBadge {
  id           Int      @id @default(autoincrement())
  skillName    String
  score        Float
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model Contract {
  id           Int      @id @default(autoincrement())
  pdfUrl       String?
  content      String   @db.Text
  signedClient Boolean  @default(false)
  signedFree   Boolean  @default(false)
  jobId        Int      @unique
  job          Job      @relation(fields: [jobId], references: [id])
  createdAt    DateTime @default(now())
}

model Task {
  id           Int      @id @default(autoincrement())
  title        String
  completed    Boolean  @default(false)
  jobId        Int
  job          Job      @relation(fields: [jobId], references: [id])
  createdAt    DateTime @default(now())
}

model Wallet {
  id        Int      @id @default(autoincrement())
  currency  String   @default("TZS")
  balance   Float    @default(0)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model Invoice {
  id          Int      @id @default(autoincrement())
  invoiceNo   String   @unique
  pdfUrl      String?
  amount      Float
  taxAmount   Float    @default(0)
  currency    String   @default("TZS")
  status      InvoiceStatus @default(UNPAID)
  jobId       Int      @unique
  job         Job      @relation(fields: [jobId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RetainerContract {
  id           Int      @id @default(autoincrement())
  title        String
  monthlyFee   Float
  currency     String   @default("TZS")
  nextChargeAt DateTime
  status       RetainerStatus @default(ACTIVE)
  clientId     Int
  client       User     @relation("ClientRetainers", fields: [clientId], references: [id])
  freelancerId Int
  freelancer   User     @relation("FreelancerRetainers", fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bounty {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  amount      Float
  status      JobStatus @default(OPEN)
  clientId    Int
  client      User     @relation("ClientBounties", fields: [clientId], references: [id])
  submissions BountySubmission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BountySubmission {
  id           Int      @id @default(autoincrement())
  content      String   @db.Text
  status       ProposalStatus @default(PENDING)
  bountyId     Int
  bounty       Bounty   @relation(fields: [bountyId], references: [id])
  freelancerId Int
  freelancer   User     @relation("FreelancerBountySubmissions", fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  FREELANCER
  CLIENT
  ADMIN
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DisputeStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum RetainerStatus {
  ACTIVE
  CANCELLED
  PAUSED
}

model ReferralReward {
  id              Int       @id @default(autoincrement())
  amount          Float     @default(0)
  status          RewardStatus @default(PENDING)
  referrerId      Int
  referrer        User      @relation("ReferralRewardGiven", fields: [referrerId], references: [id])
  referredUserId  Int
  referredUser    User      @relation("ReferralRewardReceived", fields: [referredUserId], references: [id])
  createdAt       DateTime  @default(now())
}

enum RewardStatus {
  PENDING
  PAID
  CANCELLED
}

model SystemSettings {
  id                    String   @id @default("default")
  referralPercentage    Float    @default(5.0)
  marketplaceCommission Float    @default(10.0)
  updatedAt             DateTime @updatedAt
}

// ── Phase 7: Business Growth Tools ─────────────────────────────────────────

model DigitalProduct {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @db.Text
  type         ProductType
  price        Float
  fileUrl      String   // URL ya resource au Google Drive link
  sellerId     Int
  seller       User     @relation("DigitalProductsSold", fields: [sellerId], references: [id])
  purchases    DigitalPurchase[]
  createdAt    DateTime @default(now())
}

model DigitalPurchase {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      DigitalProduct @relation(fields: [productId], references: [id])
  buyerId      Int
  buyer        User     @relation("DigitalPurchases", fields: [buyerId], references: [id])
  amount       Float
  createdAt    DateTime @default(now())
}

enum ProductType {
  COURSE
  TEMPLATE
  SNIPPET
}

model CompanyPage {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @db.Text
  website      String?
  industry     String?
  ownerId      Int      @unique
  owner        User     @relation("CompanyPageOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
}

model FavoriteFreelancer {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       User     @relation("ClientFavorites", fields: [clientId], references: [id])
  freelancerId Int
  freelancer   User     @relation("FavoritedBy", fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([clientId, freelancerId])
}

model Agency {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  ownerId     Int      @unique
  owner       User     @relation("AgencyOwner", fields: [ownerId], references: [id])
  members     AgencyMember[]
  subContracts SubContract[]
  createdAt   DateTime @default(now())
}

model AgencyMember {
  id           Int      @id @default(autoincrement())
  agencyId     Int
  agency       Agency   @relation(fields: [agencyId], references: [id])
  freelancerId Int      @unique
  freelancer   User     @relation("AgencyMemberRel", fields: [freelancerId], references: [id])
  role         String   @default("MEMBER") // ADMIN au MEMBER
  createdAt    DateTime @default(now())
}

model SubContract {
  id               Int      @id @default(autoincrement())
  jobId            Int
  job              Job      @relation("JobSubContracts", fields: [jobId], references: [id])
  agencyId         Int
  agency           Agency   @relation(fields: [agencyId], references: [id])
  subFreelancerId  Int
  subFreelancer    User     @relation("SubContractorRel", fields: [subFreelancerId], references: [id])
  taskDescription  String   @db.Text
  amount           Float
  status           SubContractStatus @default(PENDING)
  createdAt        DateTime @default(now())
}

enum SubContractStatus {
  PENDING
  ACCEPTED
  COMPLETED
  PAID
}
