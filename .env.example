# ── Telegram Bot ─────────────────────────────────────────
BOT_TOKEN="7727619319:AAGuP7NdbMoEwICiMwx6JDY5MpiQsPNMQUY"

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL="postgresql://giglink_user:AWmE7iK4HGcxACy2@localhost:5432/giglink_user"

# ── Admin IDs ─────────────────────────────────────────────
# Muundo: TelegramID:Role,TelegramID:Role
# Roles zinazopatikana: Super Admin, Trust & Safety, Finance Team
# Jinsi ya kujua ID yako: Tuma meseji kwa @userinfobot kwenye Telegram
ADMIN_IDS="123456789:Super Admin"

# ── Gemini AI (Bure!) ─────────────────────────────────────
# Pata API Key hapa: https://aistudio.google.com
# Kisha run: npm install @google/generative-ai
GEMINI_API_KEY=""

# ── M-Pesa / Daraja API (Tanzania) ───────────────────────
# Jiandikishe: https://developer.safaricom.co.ke
# Usisahau kubadilisha URL ya Sandbox → Production ukiwa tayari
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://bot.giglink.co.tz/mpesa/callback"

# ── Server ────────────────────────────────────────────────
# Acha WEBHOOK_URL wazi kama unatumia Polling (Port tu)
WEBHOOK_URL=""
PORT=3000
